# Copiar a .env junto al docker-compose.yml de este servicio.
# NUNCA versionar el archivo .env resultante.

# Verificacion del header Origin en las conexiones websocket (actualizacion
# en tiempo real de la UI). "cors-like" (por defecto) compara contra el
# header Host, que la plantilla de Nginx ya reenvia correctamente
# (proxy_set_header Host $host) - no deberia hacer falta tocar esto. Si el
# panel se queda "colgado" sin actualizar en tiempo real detras del proxy,
# el escape hatch documentado por el proyecto es "bypass".
UPTIME_KUMA_WS_ORIGIN_CHECK=cors-like

# Limites de recursos del contenedor.
UPTIME_KUMA_CPU_LIMIT=1
UPTIME_KUMA_MEMORY_LIMIT=256m
UPTIME_KUMA_MEMORY_RESERVATION=64m
