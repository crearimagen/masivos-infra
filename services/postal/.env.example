# Copiar a .env junto al docker-compose.yml de este servicio.
# NUNCA versionar el archivo .env resultante.
#
# Todas estas variables corresponden 1:1 a claves de postal.yml, usando la
# convencion de variables de entorno documentada por el propio proyecto
# (https://github.com/postalserver/postal/blob/main/doc/config/environment-variables.md).
# No se usa postal.yml para nada que pueda venir de aqui - ver
# config/README.md.

# --- Version de imagen ---
# Tag de ghcr.io/postalserver/postal. "3" seria la ultima menor de la
# serie v3; fijar una version exacta (p.ej. "3.2.1") en produccion para
# evitar que un "docker compose pull" traiga una version no probada.
POSTAL_VERSION=3

# --- Hostnames publicos ---
# Deben coincidir con los registros DNS de docs/dns.md para este entorno.
POSTAL_WEB_HOSTNAME=postal.masivos.app
POSTAL_WEB_PROTOCOL=https
POSTAL_SMTP_HOSTNAME=mail.masivos.app

# --- main_db (esquema principal de Postal) ---
# Debe coincidir EXACTAMENTE con POSTAL_DB_USER/POSTAL_DB_PASSWORD/
# POSTAL_DB_PREFIX de services/mariadb/.env - son credenciales del mismo
# usuario MariaDB, definidas en dos servicios independientes a proposito
# (cada servicio es autonomo), pero deben coincidir para que Postal se
# conecte.
MAIN_DB_HOST=127.0.0.1
MAIN_DB_PORT=3306
MAIN_DB_USERNAME=postal
MAIN_DB_PASSWORD=
MAIN_DB_DATABASE=postal

# --- message_db (una base de datos por mail server, aprovisionada por Postal) ---
MESSAGE_DB_HOST=127.0.0.1
MESSAGE_DB_PORT=3306
MESSAGE_DB_USERNAME=postal
MESSAGE_DB_PASSWORD=
MESSAGE_DB_DATABASE_NAME_PREFIX=postal

# --- SMTP server (unico puerto SMTP de Postal v3, verificado Sprint 8) ---
SMTP_SERVER_DEFAULT_PORT=25
SMTP_SERVER_DEFAULT_BIND_ADDRESS=::
SMTP_SERVER_DEFAULT_HEALTH_SERVER_PORT=9091
SMTP_SERVER_DEFAULT_HEALTH_SERVER_BIND_ADDRESS=127.0.0.1

# --- Web server ---
# 0.0.0.0, NO 127.0.0.1 (correccion Sprint 9): Nginx corre en
# masivos-network (bridge), no en network_mode: host como Postal, y
# alcanza este puerto via extra_hosts "host-gateway" - un mecanismo que
# SOLO funciona contra puertos bindeados a 0.0.0.0 (127.0.0.1 es, por
# definicion, inalcanzable desde otro namespace de red, incluida la
# puerta de enlace del bridge). La seguridad real la da UFW, que nunca
# abre el puerto 5000 (ver docs/architecture.md) - igual que el patron ya
# usado para el panel de RabbitMQ y el puerto de MariaDB.
WEB_SERVER_DEFAULT_PORT=5000
WEB_SERVER_DEFAULT_BIND_ADDRESS=0.0.0.0

# --- Proxies de confianza ---
# Direccion IP/CIDR de Nginx, para que Postal confie en la cabecera
# X-Forwarded-For y registre la IP real del cliente en vez de la de
# Nginx. Usar el mismo valor que DOCKER_NETWORK_SUBNET de
# environments/<env>/.env para este servidor (varia por entorno: dev,
# test y prod usan subnets distintas, ver environments/README.md).
POSTAL_TRUSTED_PROXIES=

# --- Worker ---
WORKER_DEFAULT_HEALTH_SERVER_PORT=9090
WORKER_DEFAULT_HEALTH_SERVER_BIND_ADDRESS=127.0.0.1
WORKER_THREADS=2

# --- Firma de mensajes ---
# Ruta DENTRO del contenedor (el host monta ./config en /config, solo
# lectura). El archivo real se genera con
# scripts/generate-signing-key.sh - NUNCA se versiona.
POSTAL_SIGNING_KEY_PATH=/config/signing.key

# --- Rails ---
# Genera un valor fuerte, p.ej.: openssl rand -hex 64
RAILS_SECRET_KEY=
RAILS_ENVIRONMENT=production

# --- DNS (deben coincidir con los registros reales, ver docs/dns.md) ---
DNS_MX_RECORDS=mail.masivos.app
DNS_SPF_INCLUDE=spf.masivos.app
DNS_RETURN_PATH_DOMAIN=rp.masivos.app
DNS_TRACK_DOMAIN=track.masivos.app
DNS_HELO_HOSTNAME=mail.masivos.app

# --- Limite de tamano de mensaje (MB) ---
# Si se cambia, revisar innodb_redo_log_capacity en
# services/mariadb/config/masivos.cnf (debe ser >= 10x este valor).
SMTP_SERVER_MAX_MESSAGE_SIZE=14
