# Copiar a .env junto al docker-compose.yml de este servicio.
# NUNCA versionar el archivo .env resultante.

# Usuario y vhost dedicados — nunca se opera sobre guest/guest ni sobre el
# vhost "/" por defecto en produccion.
RABBITMQ_DEFAULT_USER=masivos
# Genera un valor fuerte, p.ej.: openssl rand -base64 32
RABBITMQ_DEFAULT_PASS=
RABBITMQ_DEFAULT_VHOST=/masivos

# Erlang cookie: solo relevante si en el futuro se forma un cluster de
# varios nodos RabbitMQ. En un nodo unico no es estrictamente necesario,
# pero fijarlo explicitamente evita sorpresas si se agrega un segundo nodo
# mas adelante. Genera un valor fuerte, p.ej.: openssl rand -hex 32
RABBITMQ_ERLANG_COOKIE=

# Limites de recursos del contenedor. Ajustar segun el sizing del entorno
# (ver tabla en docs/architecture.md).
RABBITMQ_CPU_LIMIT=1
RABBITMQ_MEMORY_LIMIT=512m
RABBITMQ_MEMORY_RESERVATION=256m
