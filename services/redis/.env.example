# Copiar a .env junto al docker-compose.yml de este servicio.
# NUNCA versionar el archivo .env resultante.

# Genera un valor fuerte, p.ej.: openssl rand -base64 32
REDIS_PASSWORD=

# Limites de recursos del contenedor. Ajustar segun el sizing del entorno
# (ver tabla en docs/architecture.md). Valores por defecto pensados para un
# servidor dev/test de 4 GB de RAM. El limite de memoria de la aplicacion
# (maxmemory) se configura por separado en redis.conf.
REDIS_CPU_LIMIT=1
REDIS_MEMORY_LIMIT=512m
REDIS_MEMORY_RESERVATION=128m
