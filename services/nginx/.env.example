# Copiar a .env junto al docker-compose.yml de este servicio.
# NUNCA versionar el archivo .env resultante.

# Deben coincidir EXACTAMENTE con environments/<env>/.env y con
# services/postal/.env - se repiten aqui porque render-config.sh solo
# lee este archivo (cada servicio es autonomo, ver docs/architecture.md).
DOMAIN_ROOT=masivos.app
POSTAL_WEB_HOSTNAME=postal.masivos.app
GRAFANA_WEB_HOSTNAME=grafana.masivos.app

# Limites de recursos del contenedor. Ajustar segun el sizing del entorno
# (ver tabla en docs/architecture.md).
NGINX_CPU_LIMIT=1
NGINX_MEMORY_LIMIT=256m
NGINX_MEMORY_RESERVATION=64m
