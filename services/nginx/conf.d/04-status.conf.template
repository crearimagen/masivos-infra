# Generado por scripts/render-config.sh — NO editar a mano, edita este
# .template y vuelve a ejecutar el script.

server {
    listen 80;
    server_name __UPTIME_KUMA_WEB_HOSTNAME__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name __UPTIME_KUMA_WEB_HOSTNAME__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN_ROOT__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN_ROOT__/privkey.pem;

    location / {
        proxy_pass http://masivos-uptime-kuma:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Uptime Kuma usa websockets para el panel en tiempo real
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
