# Copiar a .env junto al docker-compose.yml de este servicio.
# NUNCA versionar el archivo .env resultante.

# --- Retencion de metricas ---
PROMETHEUS_RETENTION=30d

# --- Credenciales de los exporters ---
# Cada par usuario/password debe coincidir EXACTAMENTE con el usuario de
# monitoreo creado en el .env del servicio correspondiente (cada servicio
# es autonomo, ver docs/architecture.md - las credenciales se repiten a
# proposito).

# services/mariadb/.env: MONITORING_DB_USER / MONITORING_DB_PASSWORD
MYSQLD_EXPORTER_USER=exporter
MYSQLD_EXPORTER_PASSWORD=

# services/postgres/.env: MONITORING_DB_USER / MONITORING_DB_PASSWORD / POSTGRES_DB
POSTGRES_EXPORTER_USER=exporter
POSTGRES_EXPORTER_PASSWORD=
POSTGRES_EXPORTER_DATABASE=masivos

# services/redis/.env: REDIS_PASSWORD
REDIS_EXPORTER_PASSWORD=

# --- Limites de recursos del contenedor de Prometheus ---
# (los exporters son livianos, no llevan limites propios)
PROMETHEUS_CPU_LIMIT=1
PROMETHEUS_MEMORY_LIMIT=512m
PROMETHEUS_MEMORY_RESERVATION=128m
