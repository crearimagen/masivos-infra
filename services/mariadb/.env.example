# Copiar a .env junto al docker-compose.yml de este servicio.
# NUNCA versionar el archivo .env resultante.

# Credencial administrativa del propio contenedor (bootstrap, healthcheck,
# init/00-create-postal-user.sh). No es la credencial que usa Postal.
# Genera un valor fuerte, p.ej.: openssl rand -base64 32
MARIADB_ROOT_PASSWORD=

# Usuario que Postal usara para conectarse (main_db y message_db).
# Requiere privilegios de CREATE/DROP DATABASE porque Postal aprovisiona
# una base de datos nueva por cada mail server que se crea dentro de el.
# Ver init/00-create-postal-user.sh.
POSTAL_DB_USER=postal
# Genera un valor fuerte, p.ej.: openssl rand -base64 32
POSTAL_DB_PASSWORD=
# Prefijo de nombre de base de datos usado por Postal (message_db.database_name_prefix
# en postal.yml, services/postal/config). El usuario recibe permisos sobre
# cualquier base de datos que empiece con este prefijo.
POSTAL_DB_PREFIX=postal

# Usuario de solo lectura para mysqld_exporter (services/prometheus/,
# Sprint 10). El mismo valor de password debe copiarse a
# services/prometheus/.env como MYSQLD_EXPORTER_PASSWORD - ver
# init/01-create-monitoring-user.sh.
MONITORING_DB_USER=exporter
# Genera un valor fuerte, p.ej.: openssl rand -base64 32
MONITORING_DB_PASSWORD=

# Limites de recursos del contenedor. Ajustar segun el sizing del entorno
# (ver tabla en docs/architecture.md).
MARIADB_CPU_LIMIT=2
MARIADB_MEMORY_LIMIT=1g
MARIADB_MEMORY_RESERVATION=256m

# Retencion de backups locales en dias (backup/backup-mariadb.sh)
MARIADB_BACKUP_RETENTION_DAYS=14
