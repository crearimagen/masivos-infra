# Copiar a .env junto al docker-compose.yml de este servicio.
# NUNCA versionar el archivo .env resultante.

# --- Acceso publico (debe coincidir con el DNS real, ver docs/dns.md) ---
GF_SERVER_ROOT_URL=https://grafana.masivos.app
GF_SERVER_DOMAIN=grafana.masivos.app

# --- Administrador inicial ---
GF_SECURITY_ADMIN_USER=admin
# Genera un valor fuerte, p.ej.: openssl rand -base64 24
GF_SECURITY_ADMIN_PASSWORD=

# Deshabilita el registro publico de usuarios y el analitico de uso que
# Grafana envia por defecto a sus propios servidores.
GF_USERS_ALLOW_SIGN_UP=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false

# --- Limites de recursos del contenedor ---
GRAFANA_CPU_LIMIT=1
GRAFANA_MEMORY_LIMIT=256m
GRAFANA_MEMORY_RESERVATION=64m
